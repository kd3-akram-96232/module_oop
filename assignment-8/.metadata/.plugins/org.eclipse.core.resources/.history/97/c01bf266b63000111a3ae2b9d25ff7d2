package a8_question_1;

import java.util.Scanner;

public class Program {
	static Scanner scanner = new Scanner(System.in);
	static MyStack myStack;

	static void menuList() {
		System.out.println("***********");
		System.out.println("1. Add Employee");
		System.out.println("2. Peak");
		System.out.println("3. Poll");
		System.out.println("4. Display all emps");
		System.out.println("5. get emps size");
		System.out.println("***********");
	}

	static int menuActions() {
		menuList();
		int choice;
		System.out.print("Enter choice: ");
		choice = scanner.nextInt();

		switch (choice) {
		case 1:
			
			if(myStack instanceof FixedStack && myStack.isFull()) {
				System.out.println("<< Stack is Full >>");
				break;
			}
			Employee emp = new Employee();
			emp.accept(scanner);
			myStack.push(emp);
			break;
		case 2:
			Employee emp1 = myStack.peak();
			if (emp1 != null) {
				emp1.display();
			} else {
				System.out.println("Emp is null");
			}
			break;
		case 3:
			if (myStack.pop()) {
				System.out.println("true");
			} else {
				System.out.println("false");
			}
			break;
		case 4:
			for (Employee emp3 : myStack.getEmps()) {
				if (emp3 != null) {
					emp3.display();
				} 
//				else {
//					System.out.println("null");
//				}
			}
			break;
		case 5:
			int len = myStack.getEmps().length;
			System.out.println("stack length: " + len);
			break;
		}

		return choice;
	}

	public static void main(String[] args) {

		int choice;
		System.out.println("1. Fixed Stack ");
		System.out.println("2. Growable stack ");

		System.out.print("Enter which stack do you use: ");
		choice = scanner.nextInt();

		if (choice == 1) {
			int size;
			System.out.print("Enter max size of fixed stack 1 to Infinite: ");
			size = scanner.nextInt();
			myStack = new FixedStack(size);
		} else if(choice == 2){
			myStack = new GrowableStack();
		}else {
			System.out.println("You Entered wrong choice. ");
			main(args);
			return;
		}

		while (menuActions() != 0) {}

	}

}
