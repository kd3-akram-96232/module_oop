package a8_question_1;


public class GrowableStack {
//	int size;
	Employee[] emps;
	int size = 1;
	
	public GrowableStack() {
		emps = new Employee[size];
		// TODO Auto-generated constructor stub
	}

	public void push(Employee emp){
		if(size == 1) {
			emps[0] = emp;
			return;
		}
		
		Employee[] temp = new Employee[size+1];
		for(int i = 0; i < size; i++) {
			temp[i] = emps[i];
		}
		emps[temp.length - 1] = emp;
		emps = temp;
		size++;
	}
	
	public Employee peak(){
		if(size < 1) {
			return null;
		}
		return emps[emps.length - 1];
	}
	
	public boolean poll(){
		if(size > 0) {			
			Employee[] temp = new Employee[--size];
			for(int i = 0; i < size; i++) {
				emps[i] = temp[i];
			}
			emps = temp;
			return true;
		}
		return false;
	}
	
	public Employee[] getEmps() {
		return emps;
	}
	
}
