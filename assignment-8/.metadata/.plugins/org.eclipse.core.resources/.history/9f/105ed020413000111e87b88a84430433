package a8_question_1;


public class GrowableStack {
//	int size;
	Employee[] emps;
	int size = 0;
	
	public GrowableStack() {
//		this.size = 0;
		emps = new Employee[0];
	}
	
	public void push(Employee emp){
			Employee[] temp = new Employee[++size];
			for(int i = 0; i < emps.length; i++) {
				temp[i] = emps[i];
			}
			emps[size] = emp;
			emps = temp;
	}
	
	public Employee peak(){
		if(size < 1) {
			return null;
		}
		return emps[emps.length - 1];
	}
	
	public boolean poll(){
		if(index > 0) {			
			Employee[] temp = new Employee[--index];
			for(int i = 0; i < index; i++) {
				emps[i] = temp[i];
			}
			emps = temp;
			return true;
		}
		return false;
	}
	
	public Employee[] getEmps() {
		return emps;
	}
	
}
